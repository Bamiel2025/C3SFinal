# Copier ce fichier en `.env` (développement local) ou le déclarer dans
# Vercel → Project Settings → Environment Variables.

# Jeton CDS (Copernicus Climate Data Store)
# https://cds.climate.copernicus.eu/api-clients → « Set up the CDS API personal access token »
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=remplacer-par-votre-jeton

# Code enseignant (corrigés des activités). 4 à 8 chiffres.
C3S2_TEACHER_CODE=2027

# Options avancées (valeurs par défaut : ni nécessaire ni recommandé)
# C3S2_DATA_DIR=D:/chemin/vers/data
# CDSAPI_CONFIG=/chemin/vers/.cdsapirc
